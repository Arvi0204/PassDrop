{
  "name": "passhaven-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "PassDrop - Secure password management ecosystem across web, serverless API, and browser extension",
  "workspaces": [
    "frontend",
    "backend",
    "web_extension"
  ],
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"cyan,magenta\" \"npm run dev --workspace=backend\" \"npm run dev --workspace=frontend\"",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "test": "npm test --workspaces --if-present",
    "build:frontend": "npm run build --workspace=frontend",
    "install:all": "npm install",
    "build:extension": "npm run build --workspace=web_extension",
    "build:extension:dev": "npm run build:dev --workspace=web_extension",
    "package:extension": "npm run package --workspace=web_extension",
    "test:e2e": "npm run build:frontend && node e2e/vault.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
