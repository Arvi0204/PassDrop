meta {
  name: Update Password
  type: http
  seq: 3
}

put {
  url: {{baseUrl}}/api/passwords/:id
  body: json
  auth: none
}

params:path {
  id: {{createdPasswordId}}
}

headers {
  auth-token: {{authToken}}
}

body:json {
  {
    "title": "GitHub Personal",
    "notes": "Updated note with security key details",
    "isFavorite": true
  }
}

vars:pre-request {
  createdPasswordId: 6ad5cd09682d3fe111b39fd0
}
