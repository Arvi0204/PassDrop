meta {
  name: Create Password
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/passwords
  body: json
  auth: none
}

headers {
  auth-token: {{authToken}}
}

body:json {
  {
    "title": "GitHub",
    "url": "https://github.com",
    "username": "developer@example.com",
    "password": "SecretVaultPassword123!",
    "notes": "Backup codes stored securely",
    "isFavorite": true
  }
}

vars:post-response {
  createdPasswordId: res.body._id
}
