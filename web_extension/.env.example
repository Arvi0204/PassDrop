# Copy to .env and fill in. These are baked in at build time (npm run build).

# Address of the PassDrop API, no trailing slash. The extension is only allowed to talk to this origin.
VITE_BACKEND=http://localhost:3000

# Address of the PassDrop web app, used by the "Open PassDrop" link in the popup.
VITE_WEB_APP_URL=http://localhost:5173
