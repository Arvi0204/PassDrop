{
  "name": "passhaven-extension",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "description": "PassDrop browser extension: view your vault and autofill logins",
  "scripts": {
    "build": "vite build && vite build --config vite.content.config.js",
    "build:dev": "vite build --mode development && vite build --config vite.content.config.js",
    "package": "npm run build && node scripts/package.js",
    "test": "node --test test/",
    "test:browser": "vite build --config vite.content.config.js && node e2e/menu.mjs"
  },
  "devDependencies": {
    "adm-zip": "^0.5.16",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.21.5",
    "jsdom": "^31.0.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "vite": "^5.4.14"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0"
  }
}
