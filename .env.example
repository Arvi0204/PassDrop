# PassDrop settings, by file. Copy the block you need into the file named in its heading.
# None of the real .env files are committed. See the root README for what each setting does.

### backend/.env  (the API)
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/?retryWrites=true&w=majority
# JWT_SECRET=<32 or more random characters>
# (Logins are encrypted in the browser, so the server has no encryption key to set.)
# Make the secret with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Optional:
# PORT=3000
# DB_NAME=PassDrop
# JWT_EXPIRES_IN=7d

### frontend/.env  (the web app, local development)
# VITE_BACKEND=http://localhost:3000

### web_extension/.env  (the extension, local development; baked in at build time)
# Build with: npm run build:extension:dev
# VITE_BACKEND=http://localhost:3000
# VITE_WEB_APP_URL=http://localhost:5173

### web_extension/.env.production  (committed; used by release builds only)
# VITE_BACKEND=https://<your-site>
# VITE_WEB_APP_URL=https://<your-site>

### Vercel dashboard
# Do not set VITE_BACKEND in the Vercel project settings. One build makes both the web app (needs it empty, so it
# calls /api on its own domain) and the extension (needs the absolute URL above); a dashboard value overrides
# the .env files for both and breaks one of them.
